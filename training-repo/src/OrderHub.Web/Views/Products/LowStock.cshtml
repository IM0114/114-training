@model LowStockViewModel
@{
    ViewData["Title"] = "低庫存警示";
}

<h1 class="h3 mb-3">低庫存警示</h1>

<form asp-action="LowStock" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label asp-for="Threshold" class="form-label">庫存門檻</label>
        <input asp-for="Threshold" class="form-control" type="number" min="1" />
        <span asp-validation-for="Threshold" class="text-danger"></span>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">查詢</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>商品編號</th>
            <th>名稱</th>
            <th class="text-end">目前庫存</th>
            <th class="text-end">近 30 天售出</th>
            <th>狀態</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Products.Count == 0)
        {
            <tr>
                <td colspan="5" class="text-center text-muted">沒有符合條件的商品</td>
            </tr>
        }
        @foreach (var product in Model.Products)
        {
            <tr class="@(product.IsCriticalStock ? "table-danger" : null)">
                <td>@product.Sku</td>
                <td>@product.Name</td>
                <td class="text-end">@product.StockQuantity</td>
                <td class="text-end">@product.SoldQuantityLast30Days</td>
                <td>
                    @if (product.IsActive)
                    {
                        <span class="badge bg-success">販售中</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">已停售</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
